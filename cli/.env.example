# Copy to cli/.env — the file is gitignored. Real environment variables win over this file.

# Tenant (contract owner) key: the API key from https://go.terminal3.io/adk-community (shown once).
T3N_API_KEY=
# Agent key: a SEPARATE identity with its own test credits (claim a second key). Never reuse T3N_API_KEY.
AGENT_KEY=
# Data owner (user) key: the identity whose {{profile.*}} placeholders are resolved and who grants the agent.
USER_KEY=

# ERP endpoint the contract POSTs onboardings to. Seeded into z:<tid>:secrets by `kyb deploy`.
# REQUIRED for a live `deploy` / `authorize` (there is no default on live runs). For a smoke test set it
# explicitly to https://httpbin.org/post AND set KYB_ALLOW_DEMO_ERP=1 (or pass --allow-demo-erp): the echo
# service receives the resolved signatory data, so throwaway demo identities only. Leave ERP_API_KEY empty:
# `deploy` refuses to seed a bearer token next to an echo host (httpbin.org, postman-echo.com, webhook.site).
# `--dry-run` and `doctor` fall back to the demo URL when this is empty.
ERP_ONBOARDING_URL=
# KYB_ALLOW_DEMO_ERP=1
# Optional bearer token for that endpoint (sent as Authorization: Bearer … from inside the enclave).
ERP_API_KEY=

# Network / contract identity
T3N_ENV=testnet
# Attestation pinning: manifest (default: operator-signed manifest, verified) | unsafe (no attestation check).
# On 2026-09-04 testnet served a trust manifest without rtmr1_allowlist. SDK >= 5.3.0 rejects it as malformed, so this CLI
# pins @terminal3/t3n-sdk 5.2.0 (verified: 5.2.0 OK, 5.3.0/5.4.0/5.5.0/5.8.0/5.10.0 fail). Keep `manifest` (verified attestation);
# `unsafe` exists only for debugging on testnet and is refused on production.
T3N_TRUST=manifest
CONTRACT_TAIL=kyb
CONTRACT_VERSION=0.1.0

# Optional overrides (normally read from cli/.kyb-state.json, written by `deploy` / `authorize`)
# SCRIPT_NAME=z:<tid>:kyb
# USER_DID=did:t3n:<40-hex>     # pii_did for delegated calls; `kyb authorize` prints and records it
# WASM_PATH=../target/wasm32-wasip2/release/z_tenant_kyb.wasm
